{
  "name": "flagnetic",
  "version": "0.1.0",
  "description": "Flagnetic SDK for JavaScript and TypeScript: feature flags and experiments, self-hosted.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/azverinus/flagnetic.git",
    "directory": "sdks/js"
  },
  "homepage": "https://github.com/azverinus/flagnetic/tree/main/sdks/js#readme",
  "bugs": "https://github.com/azverinus/flagnetic/issues",
  "keywords": [
    "feature-flags",
    "experiments",
    "a-b-testing",
    "openfeature",
    "self-hosted"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "packageManager": "pnpm@9.15.4",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./client": {
      "import": {
        "types": "./dist/client.d.ts",
        "default": "./dist/client.js"
      },
      "require": {
        "types": "./dist/client.d.cts",
        "default": "./dist/client.cjs"
      }
    },
    "./server": {
      "import": {
        "types": "./dist/server.d.ts",
        "default": "./dist/server.js"
      },
      "require": {
        "types": "./dist/server.d.cts",
        "default": "./dist/server.cjs"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/react.d.ts",
        "default": "./dist/react.js"
      },
      "require": {
        "types": "./dist/react.d.cts",
        "default": "./dist/react.cjs"
      }
    },
    "./openfeature": {
      "import": {
        "types": "./dist/openfeature.d.ts",
        "default": "./dist/openfeature.js"
      },
      "require": {
        "types": "./dist/openfeature.d.cts",
        "default": "./dist/openfeature.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "@openfeature/server-sdk": "^1.23.0",
    "@openfeature/web-sdk": "^1.10.0",
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "@openfeature/server-sdk": {
      "optional": true
    },
    "@openfeature/web-sdk": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --project node",
    "test:p99": "vitest run --project p99",
    "test:browser": "vitest run --project browser",
    "test:browsers": "vitest run --project browsers",
    "test:e2e": "vitest run --project e2e && vitest run --project e2e-browser",
    "bench": "vitest bench --run --project \"node (bench)\"",
    "gen:unicode": "go run scripts/gen-unicode-classes.go > src/evaluator/unicode-classes.ts",
    "check:unicode": "scripts/check-unicode-classes.sh",
    "check:package": "node scripts/check-package.mjs && publint --strict && attw --pack . --profile node16",
    "check:size": "node scripts/check-size.mjs"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint/js": "^10.0.1",
    "@openfeature/server-sdk": "^1.23.0",
    "@openfeature/web-sdk": "^1.10.0",
    "@types/node": "^22.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/browser-playwright": "^5.0.5",
    "eslint": "^10.13.0",
    "playwright": "^1.63.0",
    "publint": "^0.3.24",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsup": "^9.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
