# frozen_string_literal: true

# What a consumer's bundle resolves: flagnetic from RubyGems, at the version
# the gemspec requires. Dependabot reads this file, and bumps the gemspec's
# requirement after a flagnetic release outside it. The tests run with it
# against the released flagnetic; against the working tree they run with
# tree.gemfile. OPENFEATURE_SDK_VERSION pins openfeature-sdk (empty leaves
# it unpinned), for the run on the oldest release the gem supports.

source "https://rubygems.org"

gemspec

openfeature_sdk = ENV.fetch("OPENFEATURE_SDK_VERSION", "")

gem "minitest", "~> 5.25"
gem "openfeature-sdk", openfeature_sdk unless openfeature_sdk.empty?
gem "rake", "~> 13.0"
gem "rubocop", "~> 1.71.0", require: false
