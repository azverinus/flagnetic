# frozen_string_literal: true

require "rake/testtask"

# The Rails integration's tests: a minimal Rails application in test/app,
# booted in-process and as subprocesses (console, runner, rake, Puma).
Rake::TestTask.new(:test) do |t|
  t.test_files = FileList["test/*_test.rb"]
  t.warning = false
end

task default: :test
