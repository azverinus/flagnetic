{
  "name": "@flagnetic/console",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsr generate && tsc --noEmit && vite build",
    "typecheck": "tsr generate && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "i18n:extract": "lingui extract --clean",
    "i18n:check": "lingui extract --clean && git diff --exit-code -- src/locales && test -z \"$(git status --porcelain -- src/locales)\" && lingui compile --strict"
  },
  "dependencies": {
    "@flagnetic/api": "workspace:*",
    "@hookform/resolvers": "^5.2.2",
    "@lingui/core": "^6.10.0",
    "@lingui/react": "^6.10.0",
    "@tanstack/react-query": "^5.90.2",
    "@tanstack/react-router": "^1.170.38",
    "@tanstack/react-table": "^8.21.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.545.0",
    "radix-ui": "^1.8.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.65.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@lingui/cli": "^6.10.0",
    "@lingui/format-po": "^6.10.0",
    "@lingui/vite-plugin": "^6.10.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/router-cli": "^1.167.38",
    "@tanstack/router-plugin": "^1.168.40",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "jsdom": "^27.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.0",
    "vitest": "^4.0.0"
  }
}
