{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "nameOverride": { "type": "string" },
    "fullnameOverride": { "type": "string" },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string" },
        "pullPolicy": { "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "imagePullSecrets": { "type": "array", "items": { "type": "object" } },
    "replicaCount": { "type": "integer", "minimum": 1 },
    "secrets": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "existingSecret": { "type": "string" },
        "databaseUrlKey": { "type": "string", "minLength": 1 },
        "secretKeyKey": { "type": "string", "minLength": 1 },
        "databaseUrl": { "type": "string" },
        "secretKey": { "type": "string", "pattern": "^(.{32,})?$" }
      }
    },
    "config": {
      "type": "object",
      "propertyNames": {
        "enum": [
          "base_url",
          "insecure_cookies",
          "password_hash_concurrency",
          "default_locale",
          "db_max_conns",
          "shutdown_drain",
          "shutdown_grace",
          "log_level",
          "log_format",
          "trusted_proxies",
          "http_read_header_timeout",
          "http_idle_timeout",
          "http_body_read_timeout",
          "http_write_timeout",
          "http_max_body_bytes",
          "events_retention_days",
          "events_loss_warning_hours",
          "events_partitions_ahead",
          "sdk_inventory_retention_days",
          "alias_links_limit",
          "first_exposures_limit",
          "webhook_allow_http",
          "webhook_allow_private_networks",
          "webhook_tick",
          "sink_tick",
          "sink_lag_warning",
          "sink_rejection_attempts",
          "sink_stop_after_dead_letters",
          "webhook_secret_overlap",
          "schedule_min_lead",
          "schedule_tick",
          "schedule_max_failures",
          "audit_export_max_entries",
          "audit_export_max_concurrent",
          "digest_weekday",
          "digest_hour",
          "rate_limit_client_evaluate",
          "rate_limit_client_events",
          "rate_limit_client_stream_connects",
          "rate_limit_client_concurrent_streams",
          "rate_limit_client_streams_per_replica",
          "rate_limit_server_ruleset",
          "rate_limit_server_evaluate",
          "rate_limit_server_events",
          "rate_limit_server_concurrent_streams",
          "rate_limit_failed_authentications"
        ]
      },
      "additionalProperties": { "type": ["string", "integer", "boolean"] }
    },
    "extraEnv": { "type": "array", "items": { "type": "object" } },
    "extraEnvFrom": { "type": "array", "items": { "type": "object" } },
    "migrations": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": { "enum": ["hook", "initContainer", "auto"] },
        "activeDeadlineSeconds": { "type": "integer", "minimum": 330 },
        "resources": { "type": "object" }
      }
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": { "type": "boolean" },
        "name": { "type": "string" },
        "annotations": { "type": "object" }
      }
    },
    "podAnnotations": { "type": "object" },
    "podLabels": { "type": "object" },
    "terminationGracePeriodSeconds": { "type": "integer", "minimum": 25 },
    "probes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "startup": { "$ref": "#/definitions/probe" },
        "readiness": { "$ref": "#/definitions/probe" },
        "liveness": { "$ref": "#/definitions/probe" }
      }
    },
    "resources": { "type": "object" },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": { "enum": ["ClusterIP", "NodePort", "LoadBalancer"] },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "annotations": { "type": "object" },
        "metrics": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
            "annotations": { "type": "object" }
          }
        }
      }
    },
    "podDisruptionBudget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "maxUnavailable": { "type": ["integer", "string"] }
      }
    },
    "topologySpreadConstraints": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "maxSkew": { "type": "integer", "minimum": 1 }
      }
    },
    "ingress": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "className": { "type": "string" },
        "annotations": { "type": "object" },
        "hosts": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "tls": { "type": "array", "items": { "type": "object" } }
      }
    },
    "httpRoute": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "annotations": { "type": "object" },
        "parentRefs": { "type": "array", "items": { "type": "object" } },
        "hostnames": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "serviceMonitor": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "namespace": { "type": "string" },
        "labels": { "type": "object" },
        "interval": { "type": "string", "minLength": 1 },
        "scrapeTimeout": { "type": "string" }
      }
    },
    "prometheusRule": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "namespace": { "type": "string" },
        "labels": { "type": "object" },
        "propagationSeconds": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "autoscaling": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "minReplicas": { "type": "integer", "minimum": 1 },
        "maxReplicas": { "type": "integer", "minimum": 1 },
        "targetCPUUtilizationPercentage": { "type": "integer", "minimum": 1 }
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "ingress": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "http": {
              "type": "object",
              "additionalProperties": false,
              "properties": { "from": { "type": "array", "items": { "type": "object" } } }
            },
            "metrics": {
              "type": "object",
              "additionalProperties": false,
              "properties": { "from": { "type": "array", "items": { "type": "object" } } }
            }
          }
        },
        "egress": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "dns": {
              "type": "object",
              "additionalProperties": false,
              "properties": { "to": { "type": "array", "items": { "type": "object" } } }
            },
            "postgresql": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
                "to": { "type": "array", "items": { "type": "object" } }
              }
            },
            "rules": { "type": "array", "items": { "type": "object" } }
          }
        }
      }
    },
    "nodeSelector": { "type": "object" },
    "tolerations": { "type": "array", "items": { "type": "object" } },
    "affinity": { "type": "object" },
    "test": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "image": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "repository": { "type": "string", "minLength": 1 },
            "tag": { "type": "string", "minLength": 1 },
            "digest": { "type": "string", "pattern": "^(sha256:[0-9a-f]{64})?$" }
          }
        },
        "resources": { "type": "object" }
      }
    }
  },
  "definitions": {
    "probe": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "periodSeconds": { "type": "integer", "minimum": 1 },
        "timeoutSeconds": { "type": "integer", "minimum": 1 },
        "failureThreshold": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
