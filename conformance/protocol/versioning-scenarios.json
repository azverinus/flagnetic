          }
        },
        {
          "note": "events carry the header too",
          "request": {
            "method": "POST",
            "path": "/sdk/v1/events",
            "headers": {
              "Authorization": "Bearer <sdk key>",
              "Content-Type": "application/json",
              "Flagnetic-Schema-Version": "1"
            },
            "events": {
              "types": [
                "alias"
              ]
            }
          },
          "respond": {
