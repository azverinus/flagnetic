{
  "scenarios": [
    {
      "name": "client: a ruleset event waits up to 3 seconds before the evaluate it asks for",
      "mode": "client",
      "covers": "foreground stream: the stream is held in the foreground; a change evaluates after a random wait of 0–3 s, so apps open at a kill switch do not evaluate at once",
      "given": {
        "options": {
          "allow_overrides": false,
          "flush_interval_ms": 3600000,
          "poll_interval_ms": 3600000,
          "send_exposures": true,
          "send_summaries": false,
          "sse": true,
          "summary_interval_ms": 3600000
        }
      },
      "steps": [
        {
          "request": {
            "method": "GET",
            "path": "/sdk/v1/stream",
            "absent_headers": [
              "Last-Event-ID"
            ]
          },
          "respond": {
            "headers": {
              "Cache-Control": "no-cache",
              "Content-Type": "text/event-stream"
            },
            "status": 200,
            "stream": true
          }
        },
        {
          "expect": {
            "answers_of": "server/evaluation.json",
            "stage": "fresh",
            "stale_since": "unset"
          },
          "request": {
            "headers": {
              "Authorization": "Bearer <sdk key>",
              "Content-Type": "application/json"
            },
            "method": "POST",
            "path": "/sdk/v1/evaluate"
          },
          "respond": {
            "body": "server/evaluation.json",
            "headers": {
              "Cache-Control": "no-store",
              "Content-Type": "application/json",
              "RateLimit-Limit": "120",
              "RateLimit-Remaining": "119",
              "Vary": "Accept-Encoding"
            },
            "status": 200
          }
        },
        {
          "note": "the preamble and the version held",
          "stream_send": "retry: 3000\n\nevent: ruleset\nid: 1\ndata: {\"version\":1}\n\n"
        },
        {
          "no_request": {
            "for_ms": 3000,
            "path": "/sdk/v1/evaluate"
          }
        },
        {
          "note": "a kill switch",
          "stream_send": "event: ruleset\nid: 2\ndata: {\"version\":2}\n\n"
        },
        {
          "expect": {
            "answers_of": "server/evaluation-after-kill-switch.json",
            "stage": "fresh",
            "stale_since": "unset"
          },
          "request": {
            "delay_ms": {
              "min": 0,
              "max": 3000
            },
            "headers": {
              "Authorization": "Bearer <sdk key>",
              "Content-Type": "application/json"
            },
            "method": "POST",
            "path": "/sdk/v1/evaluate"
          },
          "respond": {
            "body": "server/evaluation-after-kill-switch.json",
            "headers": {
              "Cache-Control": "no-store",
              "Content-Type": "application/json",
              "RateLimit-Limit": "120",
              "RateLimit-Remaining": "114",
              "Vary": "Accept-Encoding"
            },
            "status": 200
          }
        },
        {
          "no_request": {
            "for_ms": 3000,
            "path": "/sdk/v1/evaluate"
          }
        }
      ]
    },
