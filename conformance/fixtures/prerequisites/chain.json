  "cases": [
    {
      "name": "chain holds through every level",
      "flag": "a_on_chain",
      "expect": {
        "type": "boolean",
        "value": true,
        "variation": "true",
        "reason": "fallthrough",
        "automatic_exposure": false,
        "override_influenced": false
      },
      "context": {
        "units": {
          "user": "u1"
        },
        "attributes": {}
      }
    },
    {
      "name": "an off prerequisite fails its dependent",
      "flag": "b_off_chain",
      "expect": {
        "type": "boolean",
        "value": false,
        "variation": "false",
        "reason": "prerequisite_failed",
        "automatic_exposure": false,
        "prerequisite": "c_off",
        "override_influenced": false
      },
      "context": {
        "units": {
          "user": "u1"
        },
        "attributes": {}
      }
    },
    {
      "name": "failure propagates up the chain naming the direct prerequisite",
      "flag": "a_off_chain",
      "expect": {
        "type": "boolean",
        "value": false,
        "variation": "false",
        "reason": "prerequisite_failed",
