      "flag": "wrong_variation",
      "expect": {
        "type": "boolean",
        "value": false,
        "variation": "false",
        "reason": "prerequisite_failed",
        "automatic_exposure": false,
        "prerequisite": "c_on",
        "override_influenced": false
      },
      "context": {
        "units": {
          "user": "u1"
        },
        "attributes": {}
      }
    },
    {
