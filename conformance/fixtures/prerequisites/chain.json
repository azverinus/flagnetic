      "context": {
        "units": {
          "user": "u1"
        },
        "attributes": {}
      }
    },
    {
      "name": "an off prerequisite never holds, even when its off variation is the required one",
      "flag": "requires_off_flag_false",
      "expect": {
        "type": "boolean",
        "value": false,
        "variation": "false",
        "reason": "prerequisite_failed",
        "automatic_exposure": false,
        "prerequisite": "c_off",
        "override_influenced": false
