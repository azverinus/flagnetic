{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "bump-minor-pre-major": true,
  "include-v-in-tag": true,
  "tag-separator": "/",
  "separate-pull-requests": true,
  "pull-request-title-pattern": "chore${scope}: release${component} ${version}",
  "changelog-sections": [
    { "type": "feat", "section": "Features" },
    { "type": "fix", "section": "Bug Fixes" },
    { "type": "perf", "section": "Performance" },
    { "type": "revert", "section": "Reverts" },
    { "type": "deps", "section": "Dependencies" },
    { "type": "docs", "section": "Documentation", "hidden": true },
    { "type": "refactor", "section": "Refactoring", "hidden": true },
    { "type": "test", "section": "Tests", "hidden": true },
    { "type": "build", "section": "Build", "hidden": true },
    { "type": "ci", "section": "CI", "hidden": true },
    { "type": "chore", "section": "Miscellaneous", "hidden": true }
  ],
  "packages": {
    ".": {
      "release-type": "go",
      "initial-version": "0.1.0",
      "package-name": "flagnetic",
      "component": "server",
      "include-component-in-tag": false,
      "changelog-path": "CHANGELOG.md",
      "exclude-paths": ["eval", "sdks", "conformance", "e2e"]
    },
    "eval": {
      "release-type": "go",
      "initial-version": "0.1.0",
      "package-name": "eval",
      "component": "eval",
      "include-component-in-tag": true,
      "changelog-path": "CHANGELOG.md"
    },
    "sdks/go": {
      "release-type": "go",
      "initial-version": "0.1.0",
      "package-name": "sdks/go",
      "component": "sdks/go",
      "include-component-in-tag": true,
      "changelog-path": "CHANGELOG.md",
      "extra-files": ["version.go"]
    },
    "sdks/go-openfeature": {
      "release-type": "go",
      "initial-version": "0.1.0",
      "package-name": "sdks/go-openfeature",
      "component": "sdks/go-openfeature",
      "include-component-in-tag": true,
      "changelog-path": "CHANGELOG.md"
    },
    "sdks/js": {
      "release-type": "node",
      "initial-version": "0.1.0",
      "package-name": "flagnetic",
      "component": "sdks/js",
      "include-component-in-tag": true,
      "changelog-path": "CHANGELOG.md",
      "extra-files": ["src/version.ts"]
    },
    "sdks/python": {
      "release-type": "python",
      "initial-version": "0.1.0",
      "package-name": "flagnetic",
      "component": "sdks/python",
      "include-component-in-tag": true,
      "changelog-path": "CHANGELOG.md",
      "extra-files": ["src/flagnetic/_version.py"]
    },
    "sdks/dart": {
      "release-type": "dart",
      "initial-version": "0.1.0",
      "package-name": "flagnetic",
      "component": "sdks/dart",
      "include-component-in-tag": true,
      "changelog-path": "CHANGELOG.md",
      "extra-files": ["lib/src/client/options.dart"]
    },
    "sdks/flutter": {
      "release-type": "dart",
      "initial-version": "0.1.0",
      "package-name": "flagnetic_flutter",
      "component": "sdks/flutter",
      "include-component-in-tag": true,
      "changelog-path": "CHANGELOG.md"
    }
  }
}
